# Public installer downloads, package repositories and update payloads.
# Match distribution hosts instead of whole account or application domains.
# Excludes downloads.claude.ai by explicit user preference.
# GitHub: download hosts only; github.com keeps its existing policy.
DOMAIN,release-assets.githubusercontent.com
DOMAIN,objects.githubusercontent.com
DOMAIN,codeload.github.com
DOMAIN,raw.githubusercontent.com

# npm public registry (the same host can also serve authenticated private packages).
DOMAIN,registry.npmjs.org

